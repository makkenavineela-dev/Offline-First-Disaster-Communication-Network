# ─── Required ─────────────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb://localhost:27017/resq-disaster-app
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ─── Peer Gossip (WiFi mesh hopping between backends) ────────────────────────
# Each backend needs a unique node ID. Backends connect to each other so
# messages can hop across WiFi zones beyond the range of a single backend.
#
#   Example: 3 laptops, each running this backend
#     Laptop A:  RESQ_NODE_ID=node-A  RESQ_PEERS=http://192.168.1.21:5000,http://192.168.1.22:5000
#     Laptop B:  RESQ_NODE_ID=node-B  RESQ_PEERS=http://192.168.1.20:5000,http://192.168.1.22:5000
#     Laptop C:  RESQ_NODE_ID=node-C  RESQ_PEERS=http://192.168.1.20:5000,http://192.168.1.21:5000
#
RESQ_NODE_ID=
RESQ_PEERS=

# ─── Optional ─────────────────────────────────────────────────────────────────
NODE_ENV=development
ALLOWED_ORIGINS=
